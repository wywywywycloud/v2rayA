table inet v2raya {
	set whitelist {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 0.0.0.0/8, 10.0.0.0/8,
			     100.64.0.0/10, 127.0.0.0/8,
			     169.254.0.0/16, 172.16.0.0/12,
			     192.0.0.0/24, 192.0.2.0/24,
			     192.88.99.0/24, 192.168.0.0/16,
			     198.51.100.0/24, 203.0.113.0/24,
			     224.0.0.0/3 }
	}

	set whitelist6 {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { ::/127,
			     fc00::/7,
			     fe80::/10,
			     ff00::/8 }
	}

	set local_ips {
		type ipv4_addr
		flags interval
		auto-merge
		elements = { 10.0.2.0/24, 127.0.0.0/8,
			     192.0.2.0/24 }
	}

	set local_ips6 {
		type ipv6_addr
		flags interval
		auto-merge
		elements = { ::1,
			     fdeb:de19:47d5::/60,
			     fe80::/64 }
	}

	chain tp_out {
		meta mark & 0x00000080 == 0x00000080 return
		meta l4proto { tcp, udp } fib saddr type local fib daddr type != local jump tp_rule
	}

	chain tp_pre {
		iifname "lo" meta mark & 0x000000c0 != 0x00000040 return
		meta l4proto { tcp, udp } fib saddr type != local fib daddr type != local jump tp_rule
		meta l4proto { tcp, udp } th dport 52353 return
		meta l4proto { tcp, udp } meta mark & 0x000000c0 == 0x00000040 th dport 53 tproxy ip to 127.2.0.17:52353
		meta l4proto { tcp, udp } meta mark & 0x000000c0 == 0x00000040 th dport 53 tproxy ip6 to [::1]:52353
		meta l4proto { tcp, udp } meta mark & 0x000000c0 == 0x00000040 tproxy ip to 127.0.0.1:52345
		meta l4proto { tcp, udp } meta mark & 0x000000c0 == 0x00000040 tproxy ip6 to [::1]:52345
	}

	chain dns_mark {
		meta mark & 0x00000080 == 0x00000080 return
		meta mark set meta mark | 0x00000040
		accept
	}

	chain output {
		type route hook output priority mangle - 5; policy accept;
		meta nfproto { ipv4, ipv6 } meta l4proto { tcp, udp } th dport 53 jump dns_mark
		meta nfproto { ipv4, ipv6 } jump tp_out
	}

	chain prerouting {
		type filter hook prerouting priority mangle - 5; policy accept;
		meta nfproto { ipv4, ipv6 } meta l4proto { tcp, udp } th dport 53 jump dns_mark
		meta nfproto { ipv4, ipv6 } jump tp_pre
	}

	chain tp_rule {
		meta mark set ct mark
		meta mark & 0x000000c0 == 0x00000040 return
		iifname "docker*" return
		iifname "veth*" return
		iifname "wg*" return
		iifname "ppp*" return
		oifname "docker*" return
		oifname "veth*" return
		oifname "wg*" return
		oifname "ppp*" return
		meta l4proto { tcp, udp } th dport 53 jump tp_mark
		meta mark & 0x000000c0 == 0x00000040 return
		ip daddr @local_ips return
		ip daddr @whitelist return
		ip6 daddr @whitelist6 return
		ip6 daddr @local_ips6 return
		jump tp_mark
	}

	chain tp_mark {
		tcp flags & (fin | syn | rst | ack) == syn meta mark set meta mark | 0x00000040
		meta l4proto udp ct state new meta mark set meta mark | 0x00000040
		ct mark set meta mark
	}
}
